# Optional OpenAI-compatible provider. Leave the key blank for deterministic-only use.
# Do not put a real key in this file or commit .env files.
VERITYLENS_LLM_API_KEY=
VERITYLENS_LLM_MODEL=gpt-4o-mini
VERITYLENS_LLM_BASE_URL=https://api.openai.com/v1

# Public deployments should leave URL fetching disabled to reduce SSRF exposure.
# Opt in only for trusted local use after reviewing README security limitations.
VERITYLENS_ENABLE_URL_FETCH=
